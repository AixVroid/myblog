---
import type { CardLink } from '../data/card';
import CardNavCell from './CardNavCell.astro';

export interface Props {
  links: CardLink[];
}

const { links } = Astro.props;

// 三列结构：左列放前半，中间列留白（单格跨满整列），右列放后半
const half = Math.ceil(links.length / 2);
const left = links.slice(0, half);
const right = links.slice(half);
---

<nav class="card-nav" aria-label="站点导航">
  <div class="nav-col">
    {left.map((link) => <CardNavCell link={link} />)}
  </div>

  <div class="card-nav__spacer" aria-hidden="true"></div>

  <div class="nav-col">
    {right.map((link) => <CardNavCell link={link} />)}
  </div>
</nav>
