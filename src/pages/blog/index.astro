---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../consts';
import { byDateDesc } from '../../lib/utils';
import { url } from '../../lib/url';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(byDateDesc);

// 按年份分组，年份倒序
const years = new Map<string, typeof posts>();
for (const post of posts) {
  const year = String(post.data.pubDate.getFullYear());
  if (!years.has(year)) years.set(year, []);
  years.get(year)!.push(post);
}

const pad = (n: number) => String(n).padStart(2, '0');
const mmdd = (d: Date) => `${pad(d.getMonth() + 1)}-${pad(d.getDate())}`;
---

<BaseLayout title="文章" description={SITE.description}>
  <div class="archive-page">
    <h1 class="visually-hidden">全部文章</h1>

    {
      posts.length === 0 ? (
        <p class="empty">还没有文章。在 <code>src/content/blog/</code> 里新建一个 <code>.md</code> 文件就会出现在这里。</p>
      ) : (
        [...years.entries()].map(([year, items]) => (
          <section class="year-block" aria-labelledby={`y-${year}`}>
            <div class="year-col">
              <h2 class="year" id={`y-${year}`}>{year}</h2>
              <p class="year-count">{items.length} 篇</p>
            </div>

            <ul class="post-list">
              {items.map((post) => (
                <li>
                  <a href={url(`/blog/${post.id}/`)}>
                    <time datetime={post.data.pubDate.toISOString()}>{mmdd(post.data.pubDate)}</time>
                    <span class="post-title">{post.data.title}</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))
      )
    }
  </div>
</BaseLayout>

<style>
  .archive-page {
    max-width: 900px;
    margin: 0 auto;
    padding: clamp(40px, 6vw, 72px) clamp(20px, 5vw, 32px) clamp(72px, 10vw, 120px);
  }

  .year-block {
    display: grid;
    grid-template-columns: 96px 1fr;
    gap: clamp(16px, 4vw, 48px);
    margin-bottom: clamp(40px, 6vw, 64px);
  }

  .year {
    font-family: var(--font-sans);
    font-size: 1.95rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.1;
    margin: 0;
  }

  .year-count {
    margin: 6px 0 0;
    font-size: 0.78rem;
    color: var(--fg-muted);
    letter-spacing: 0.02em;
  }

  .post-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .post-list li + li {
    margin-top: clamp(26px, 3.6vw, 44px);
  }

  .post-list a {
    display: flex;
    align-items: baseline;
    gap: clamp(14px, 2.4vw, 28px);
  }

  .post-list time {
    flex: none;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--fg-muted);
    letter-spacing: 0.02em;
    font-variant-numeric: tabular-nums;
  }

  .post-title {
    font-size: clamp(0.98rem, 1.4vw, 1.06rem);
    line-height: 1.55;
    color: var(--fg);
    text-wrap: pretty;
    transition: color 0.18s ease;
  }

  .post-list a:hover .post-title {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-thickness: 1px;
    text-decoration-color: color-mix(in srgb, var(--accent) 45%, transparent);
  }

  .post-list a:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
    border-radius: 2px;
  }

  @media (max-width: 560px) {
    .year-block {
      grid-template-columns: 1fr;
      gap: 14px;
    }

    .year {
      font-size: 1.4rem;
    }

    .year-col {
      display: flex;
      align-items: baseline;
      gap: 10px;
    }

    .year-count {
      margin: 0;
    }
  }
</style>
